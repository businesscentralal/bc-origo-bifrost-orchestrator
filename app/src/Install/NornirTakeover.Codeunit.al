    /// <summary>Copies the Telegram chat id from the published app's user setup extension.</summary>
    local procedure TakeOverTelegramChatId()
    var
        OldRef: RecordRef;
        NewRef: RecordRef;
        OldField: FieldRef;
        NewField: FieldRef;
        Copied: Integer;
    begin
        if not OldTableExists(10075509) then
            exit;
        OldRef.Open(10075509);
        if not OldRef.FieldExist(10076035) then begin
            OldRef.Close();
            exit;
        end;
        NewRef.Open(10077909);
        if NewRef.FindSet(true) then
            repeat
                NewField := NewRef.Field(10035535);
                if Format(NewField.Value()) = '' then
                    if FindMatchingRow(NewRef, OldRef) then begin
                        OldField := OldRef.Field(10076035);
                        if Format(OldField.Value()) <> '' then begin
                            NewField.Value(OldField.Value());
                            NewRef.Modify(false);
                            Copied += 1;
                        end;
                    end;
            until NewRef.Next() = 0;
        NewRef.Close();
        OldRef.Close();
        if Copied > 0 then
            LogTakeOver('User Setup ori.Telegram Chat ID ori', Copied);
    end;

    /// <summary>Grants the Bifrost permission sets to every user that held an old one.</summary>
    local procedure TakeOverAccessControl()
    var
        Migrated: Integer;
    begin
        Migrated += MigrateRole('CE Orchestrator ori', 'BIFROST Nornir ori');
        Migrated += MigrateRole('CE Orch. Setup ori', 'BIFROST NrnSetup ori');
        Migrated += MigrateRole('CE Orch. Mgt ori', 'BIFROST NrnMgt ori');
        Migrated += MigrateRole('CE PlaybookAdmin ori', 'BIFROST PlaybAdm ori');
        Migrated += MigrateRole('CE Playbook View ori', 'BIFROST PlaybVw ori');
        if Migrated > 0 then
            LogTakeOver('Access Control', Migrated);
    end;

    local procedure MigrateRole(OldRoleId: Code[20]; NewRoleId: Code[20]) Migrated: Integer
    var
        OldAccessControl: Record "Access Control";
        NewAccessControl: Record "Access Control";
        NewAppId: Guid;
    begin
        NewAppId := AppId();
        OldAccessControl.SetRange("Role ID", OldRoleId);
        OldAccessControl.SetRange("App ID", OldAppId());
        if OldAccessControl.FindSet() then
            repeat
                if not NewAccessControl.Get(
                    OldAccessControl."User Security ID", NewRoleId, OldAccessControl."Company Name",
                    OldAccessControl.Scope, NewAppId)
                then begin
                    NewAccessControl.Init();
                    NewAccessControl."User Security ID" := OldAccessControl."User Security ID";
                    NewAccessControl."Role ID" := NewRoleId;
                    NewAccessControl."Company Name" := OldAccessControl."Company Name";
                    NewAccessControl.Scope := OldAccessControl.Scope;
                    NewAccessControl."App ID" := NewAppId;
                    if NewAccessControl.Insert(true) then
                        Migrated += 1;
                end;
            until OldAccessControl.Next() = 0;
    end;

    /// <summary>Copies BLOB fields, which DataTransfer does not support, row by row.</summary>
    local procedure CopyBlobFields(OldTableId: Integer; NewTableId: Integer; BlobFieldNos: List of [Integer])
    var
        TempBlob: Codeunit "Temp Blob";
        OldRef: RecordRef;
        NewRef: RecordRef;
        BlobField: FieldRef;
        BlobFieldNo: Integer;
        Modified: Boolean;
    begin
        OldRef.Open(OldTableId);
        NewRef.Open(NewTableId);
        if NewRef.FindSet(true) then
            repeat
                if FindMatchingRow(NewRef, OldRef) then begin
                    Modified := false;
                    foreach BlobFieldNo in BlobFieldNos do begin
                        BlobField := OldRef.Field(BlobFieldNo);
                        BlobField.CalcField();
                        Clear(TempBlob);
                        TempBlob.FromRecordRef(OldRef, BlobFieldNo);
                        if TempBlob.HasValue() then begin
                            TempBlob.ToRecordRef(NewRef, BlobFieldNo);
                            Modified := true;
                        end;
                    end;
                    if Modified then
                        NewRef.Modify(false);
                end;
            until NewRef.Next() = 0;
        NewRef.Close();
        OldRef.Close();
    end;

    /// <summary>Finds the row in the old table that carries the same primary key values.</summary>
    local procedure FindMatchingRow(var NewRef: RecordRef; var OldRef: RecordRef): Boolean
    var
        NewKeyField: FieldRef;
        OldKeyField: FieldRef;
        NewKey: KeyRef;
        i: Integer;
    begin
        OldRef.Reset();
        NewKey := NewRef.KeyIndex(1);
        for i := 1 to NewKey.FieldCount() do begin
            NewKeyField := NewKey.FieldIndex(i);
            if not OldRef.FieldExist(NewKeyField.Number()) then
                exit(false);
            OldKeyField := OldRef.Field(NewKeyField.Number());
            OldKeyField.SetRange(NewKeyField.Value());
        end;
        exit(OldRef.FindFirst());
    end;

    /// <summary>Shifts values that carried an object id or enum ordinal from an old range.</summary>
    local procedure ShiftIntegerField(TableId: Integer; FieldNo: Integer; FromValue: Integer; ToValue: Integer; Offset: Integer)
    var
        RecRef: RecordRef;
        TargetField: FieldRef;
        FieldValue: Integer;
    begin
        RecRef.Open(TableId);
        if RecRef.FindSet(true) then
            repeat
                TargetField := RecRef.Field(FieldNo);
                FieldValue := TargetField.Value();
                if (FieldValue >= FromValue) and (FieldValue <= ToValue) then begin
                    TargetField.Value(FieldValue + Offset);
                    RecRef.Modify(false);
                end;
            until RecRef.Next() = 0;
        RecRef.Close();
    end;

    /// <summary>Reports whether the published app's table still exists in the database.</summary>
    local procedure OldTableExists(OldTableId: Integer): Boolean
    var
        TableMetadata: Record "Table Metadata";
    begin
