/// <summary>
/// Builds the Markdown overview of all Job Queue and Playbook Workflow message types that the
/// Help.Orchestrator.Get message type returns. Each message type describes itself through its
/// contract chapters (Msg Contract ori), not through this codeunit.
/// </summary>
namespace Origo.Bifrost.Orchestrator;

codeunit 10035576 "Help ori"
{
    Access = Internal;

    /// <summary>
    /// Returns the AI-friendly overview of every Job Queue and Playbook Workflow message type,
    /// including the setup guide for building and scheduling playbooks via Data.Records.Set/Get.
    /// </summary>
    /// <returns>Markdown-formatted overview document as Text.</returns>
    procedure GetOverview() OverviewText: Text
    var
        O: TextBuilder;
    begin
        BuildOverview(O);
        exit(O.ToText());
    end;

    local procedure BuildOverview(var O: TextBuilder)
    begin
        O.AppendLine('# Job Queue Orchestrator & Playbook Workflow Engine');
        O.AppendLine('');
        O.AppendLine('21 Bifrost message types for managing job queues, building workflow playbooks, and generating reports.');
        O.AppendLine('Call `Help.Implementation.Get` with `subject = "<type>"` for per-type technical guides.');
        O.AppendLine('');
        O.AppendLine('## Quick Decision Tree for AI Agents');
        O.AppendLine('');
        O.AppendLine('**I need to...**');
        O.AppendLine('- Check orchestrator health → `Orchestrator.Status.Get`');
        O.AppendLine('- Restart the orchestrator → `Orchestrator.Status.Restart` or `Orchestrator.Status.RestartIfNeeded`');
        O.AppendLine('- Run an orchestrator entry now → `Orchestrator.Entry.Run`');
        O.AppendLine('- Restart a failed entry → `Orchestrator.Entry.Restart` or `Orchestrator.JobQueueEntry.Restart`');
        O.AppendLine('- Register a JQ entry → `Orchestrator.Entry.Register`');
        O.AppendLine('- Schedule an entry → `Orchestrator.Entry.Schedule`');
        O.AppendLine('- Build a workflow → read "Building a playbook safely" and "Worked Playbook Examples" below first, then create the playbook + steps via `Data.Records.Set` with every step disabled, and set request templates with `@` workspace references');
        O.AppendLine('- Run a workflow → `Orchestrator.Playbook.Run`');
        O.AppendLine('- Queue a workflow for later → `Orchestrator.Playbook.Enqueue`');
        O.AppendLine('- Check a workflow for errors and unsafe configuration before it runs or is scheduled → `Orchestrator.Playbook.Verify` (Run and Schedule verify again and refuse what does not verify)');
        O.AppendLine('- Send a Telegram message → `Orchestrator.Telegram.Message`');
        O.AppendLine('- List available reports → `Orchestrator.Report.List`');
        O.AppendLine('- Get report details + layouts → `Orchestrator.Report.Get`');
        O.AppendLine('- Inspect or export report layouts → `Orchestrator.ReportLayout.List` / `Orchestrator.ReportLayout.Get`');
        O.AppendLine('- Generate PDF/Excel/Word report → `Orchestrator.Report.SaveAs`');
        O.AppendLine('- Run a batch job / processing-only report → `Orchestrator.Report.Run`');
        O.AppendLine('- See what workspace variables are available → `Orchestrator.Workspace.Preview`');
        O.AppendLine('');
        BuildSafeAuthoringGuide(O);
        BuildWorkedExamples(O);
        O.AppendLine('## Message Types (21)');
        O.AppendLine('');
        O.AppendLine('| Type | Description |');
        O.AppendLine('|---|---|');
        O.AppendLine('| `Orchestrator.Entry.Run` | Execute entry immediately (one-time) |');
        O.AppendLine('| `Orchestrator.Entry.Restart` | Restart a failed/held entry |');
        O.AppendLine('| `Orchestrator.Entry.Register` | Register a Job Queue Entry as an orchestrator entry |');
        O.AppendLine('| `Orchestrator.Entry.Schedule` | Delete + immediately reschedule entry |');
        O.AppendLine('| `Orchestrator.Email.Send` | Send an email (same params as Email.Draft.Set) |');
        O.AppendLine('| `Orchestrator.Status.Get` | Get orchestrator health + entry counts |');
        O.AppendLine('| `Orchestrator.Status.Restart` | Restart orchestrator unconditionally |');
        O.AppendLine('| `Orchestrator.Status.RestartIfNeeded` | Restart only if not running |');
        O.AppendLine('| `Orchestrator.JobQueueEntry.Restart` | Restart any Job Queue Entry |');
        O.AppendLine('| `Orchestrator.JobQueueEntry.RestartIfNeeded` | Restart only if in Error/On Hold |');
        O.AppendLine('| `Orchestrator.Playbook.Run` | Execute playbook, return results |');
        O.AppendLine('| `Orchestrator.Playbook.Schedule` | Schedule playbook as an Orchestrator Entry with recurring template |');
        O.AppendLine('| `Orchestrator.Playbook.Enqueue` | Queue playbook for one-time execution with custom data |');
        O.AppendLine('| `Orchestrator.Playbook.Verify` | Read a playbook and return errors and warnings (unknown message type or role, bad template, ungated per-item write ...) before it runs |');
        O.AppendLine('| `Orchestrator.Telegram.Message` | Send a Telegram message to the current user |');
        O.AppendLine('| `Orchestrator.Report.List` | List available reports with metadata |');
        O.AppendLine('| `Orchestrator.Report.Get` | Get report details, layouts, and saved preset |');
        O.AppendLine('| `Orchestrator.ReportLayout.List` | List extension and user-defined report layouts |');
        O.AppendLine('| `Orchestrator.ReportLayout.Get` | Export layout bytes without changing defaults |');
        O.AppendLine('| `Orchestrator.Report.SaveAs` | Generate report output (PDF, Excel, Word, XML) |');
        O.AppendLine('| `Orchestrator.Report.Run` | Run a processing-only report (batch job) |');
        O.AppendLine('| `Orchestrator.Workspace.Preview` | Preview seeded workspace (_sys dates, _who user context) |');
        O.AppendLine('| `Help.Orchestrator.Get` | This help document |');
        O.AppendLine('');
        O.AppendLine('## Run Reporting — `_run` and `_steps`');
        O.AppendLine('');
        O.AppendLine('The runner maintains two reserved top-level workspace keys. Reference them together');
        O.AppendLine('as `@_run,_steps` to hand a language model the whole execution narrative with none of');
        O.AppendLine('the bulk data the steps collected.');
        O.AppendLine('');
        O.AppendLine('`_run` — playbook status:');
        O.AppendLine('```json');
        O.AppendLine('{ "playbookCode": "MONTHEND", "instanceId": "...", "durationMs": 41230,');
        O.AppendLine('  "stepsExecuted": 7, "stepsSucceeded": 5, "stepsFailed": 2, "stepsSkipped": 1,');
        O.AppendLine('  "itemsProcessed": 143, "itemsFailed": 2, "failed": true,');
        O.AppendLine('  "firstFailedStepNo": 30, "failedStepNos": [30, 50] }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('`_steps.<stepNo>` — one entry per step, accumulating across pages and iterations:');
        O.AppendLine('```json');
        O.AppendLine('{ "stepNo": 30, "description": "Post sales invoices", "messageType": "Sales.Document.Post",');
        O.AppendLine('  "status": "Failed", "durationMs": 1180, "iterated": true, "pages": 1,');
        O.AppendLine('  "items": { "total": 5, "succeeded": 3, "failed": 2, "skipped": 0, "checkFailed": 0, "errored": 0 },');
        O.AppendLine('  "failures": [ { "iteration": 2, "outcome": "Failed",');
        O.AppendLine('                  "item": { "no": "103002", "name": "CRONUS Ltd." },');
        O.AppendLine('                  "error": "Posting Date is not within your range." } ],');
        O.AppendLine('  "result": { "postedInvoices": 3, "totalAmount": 45280 } }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('`_run.itemsProcessed` is the total number of *iterations* across every forEach step,');
        O.AppendLine('not the number of distinct items the playbook handled. Three customers taken through');
        O.AppendLine('four forEach steps count as twelve. When a report needs "how many customers", read');
        O.AppendLine('`_steps.<no>.items.total` for the specific step, and say which step it came from —');
        O.AppendLine('a language model handed `itemsProcessed` will confidently call it a customer count.');
        O.AppendLine('');
        O.AppendLine('`checkFailed` counts the iterations of a `Check` step that answered no. `errored` counts the iterations of a');
        O.AppendLine('`Check` step whose message type raised an error or answered `status: "Error"` (or `Refused`, `Failed`). Those are');
        O.AppendLine('technical failures, counted in `failed` as well, and never in `checkFailed`. `errored` appears only when it is above 0.');
        O.AppendLine('');
        O.AppendLine('`failures` is capped at 20 entries per step (`failuresTruncated` flags the cut), errors');
        O.AppendLine('are truncated to 500 characters, and `item` is a projection of at most 5 scalar fields.');
        O.AppendLine('The counts stay exact regardless. The full request, response and error text remain in');
        O.AppendLine('the step log — filter it by `@_run.instanceId` when the report needs more.');
        O.AppendLine('');
        O.AppendLine('`result` is populated from the step''s `Summary Paths`, which is deliberately separate');
        O.AppendLine('from `Result Log Paths`: the latter feeds later steps and often carries large arrays,');
        O.AppendLine('the former feeds the report and must stay small.');
        O.AppendLine('');
        O.AppendLine('### The reporting tail');
        O.AppendLine('');
        O.AppendLine('A notification tail is four steps: compose and send for success, compose and send for');
        O.AppendLine('failure. Every step carries `Exclude From Run Status`. This is the shape running in');
        O.AppendLine('production, verified on both branches:');
        O.AppendLine('');
        O.AppendLine('```');
        O.AppendLine('Step 900  Start: _run.failed Equals false        [Exclude From Run Status]');
        O.AppendLine('          AND _who.telegramChatId Exists');
        O.AppendLine('          LLM.Prompt.Complete  prompt "@_run,_steps"');
        O.AppendLine('          Result Log Paths: text>noticeText       → next 910 on BOTH edges');
        O.AppendLine('Step 910  Start: 900.noticeText Exists           [Exclude From Run Status]');
        O.AppendLine('          Orchestrator.Telegram.Message  {"message":"@900.noticeText"}');
        O.AppendLine('                                                  → next 920 on BOTH edges');
        O.AppendLine('Step 920  Start: _run.failed Equals true         [Exclude From Run Status]');
        O.AppendLine('          ... same shape, → 930');
        O.AppendLine('Step 930  Start: 920.noticeText Exists           [Exclude From Run Status]');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('Four rules, each of which cost a debugging round to learn:');
        O.AppendLine('');
        O.AppendLine('1. **Point both edges at the next tail step.** A tail step that is skipped, or that');
        O.AppendLine('   fails because a provider was down, must not end the chain — the other branch still');
        O.AppendLine('   has to get its chance. Leaving `Next Step No. (Failure)` at 0 silently drops the');
        O.AppendLine('   failure notification exactly when it is most wanted.');
        O.AppendLine('2. **Guard the send step on the composed text existing**, not on the run outcome. If');
        O.AppendLine('   the compose step was skipped there is nothing to send, and the model occasionally');
        O.AppendLine('   returns an empty completion even when it succeeds.');
        O.AppendLine('3. **Guard on the delivery address too.** `_who.telegramChatId Exists` AND');
        O.AppendLine('   `NotEquals ""` — a user with no chat ID should skip the notice, not fail the run.');
        O.AppendLine('4. **The whole tail is excluded from run status**, so it never narrates itself or');
        O.AppendLine('   inflates the totals the notice is about.');
        O.AppendLine('');
        O.AppendLine('### `_tail` — where excluded steps are recorded');
        O.AppendLine('');
        O.AppendLine('An excluded step is not dropped from the workspace; it is recorded under `_tail.<no>`');
        O.AppendLine('with the same shape as a `_steps` entry. It stays out of `_run` totals and out of the');
        O.AppendLine('`@_run,_steps` dump the report is built from, while remaining referenceable — so one');
        O.AppendLine('tail step can condition on another''s outcome via `_tail.910.status`.');
        O.AppendLine('');
        O.AppendLine('Do not confuse the two namespaces a step writes to:');
        O.AppendLine('');
        O.AppendLine('| Written by | Path | Purpose |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `Result Log Paths` | `<stepNo>.<field>` | Data for later steps. Unaffected by exclusion |');
        O.AppendLine('| `Summary Paths` | `_steps.<no>.result` or `_tail.<no>.result` | Figures for the report |');
        O.AppendLine('| the runner | `_steps.<no>` or `_tail.<no>` | Status, duration, errors, item counts |');
        O.AppendLine('');
        O.AppendLine('This is why the send step above references `@900.noticeText` and not');
        O.AppendLine('`@_tail.900.result.noticeText`: `Result Log Paths` writes to the step-number');
        O.AppendLine('namespace whether or not the step is excluded.');
        O.AppendLine('');
        O.AppendLine('## Common Playbook Step Types (from Core Library)');
        O.AppendLine('');
        O.AppendLine('Playbook steps can call **any** registered message type. These are the most commonly used:');
        O.AppendLine('');
        O.AppendLine('| Type | Purpose | Help |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `Data.Records.Get` | Read records from any BC table | `Help.Implementation.Get` subject `Data.Records.Get` |');
        O.AppendLine('| `Data.Records.Set` | Write/update records in any BC table | `Help.Implementation.Get` subject `Data.Records.Set` |');
        O.AppendLine('| `LLM.Prompt.Complete` | One-shot AI completion for reasoning, formatting, decisions | `Help.Implementation.Get` subject `LLM.Prompt.Complete` |');
        O.AppendLine('| `Email.Draft.Set` | Create email draft with attachments | `Help.Implementation.Get` subject `Email.Draft.Set` |');
        O.AppendLine('| `Customer.Statement.Pdf` | Generate customer statement PDF | `Help.Implementation.Get` subject `Customer.Statement.Pdf` |');
        O.AppendLine('| `Iceland.Kennitala.Validate` | Validate Icelandic kennitala | `Help.Implementation.Get` subject `Iceland.Kennitala.Validate` |');
        O.AppendLine('| `Iceland.AddressInfo.Get` | Lookup address from national registry | `Help.Implementation.Get` subject `Iceland.AddressInfo.Get` |');
        O.AppendLine('| `DocumentExchange.Advania.*` | E-document exchange (GetUnread, GetDocument, UpdateStatus) | `Help.Implementation.Get` subject `DocumentExchange.Advania.GetUnread` |');
        O.AppendLine('');
        O.AppendLine('**When no standard message type fits** → use `LLM.Prompt.Complete` as the glue step.');
        O.AppendLine('Always call `Help.Implementation.Get` with the message type name before using it in a playbook.');
        O.AppendLine('');
        BuildPlaybookWorkflowGuide(O);
        BuildDataRecordsGuide(O);
        BuildSchedulingGuide(O);
        BuildLLMPatternsGuide(O);
        BuildAgentRules(O);
    end;

    local procedure BuildSafeAuthoringGuide(var O: TextBuilder)
    begin
        O.AppendLine('## Building a playbook safely');
        O.AppendLine('');
        O.AppendLine('A playbook runs unattended and its steps commit one by one (see "Execution Model"): nothing is rolled back when a later step goes wrong. The only safety net is what you check before it runs. Follow these seven steps, in order, every time you build or change a playbook. `Orchestrator.Playbook.Run` and the schedule refuse a playbook that does not verify (step 4), but finding a mistake there costs more than not making it.');
        O.AppendLine('');
        O.AppendLine('1. **Design the steps on paper.** For every step write down whether it is a *read* (`Data.Records.Get`), a *decision* (a `Check` step) or a *write* (`Data.Records.Set`, `*.Post`, `Orchestrator.Email.Send`, `Orchestrator.Telegram.Message`), and whether it runs once or once per record (a forEach). For every write that runs per record, name the decision step that gates it: the write needs `Skip If Step Failed` pointing at that step (see "Per-item decisions in a forEach").');
        O.AppendLine('2. **Check that everything you name exists.** Message types: `describe_message_type`, or `Help.Implementation.Get` with `subject = "<type>"`, and `Help.MessageTypes.Get` for the list; copy the exact name. Language model role codes (`roleCode` of `LLM.Prompt.Complete`): `Data.Records.Get` with `{"tableName":"Bifrost Language Model ori"}`; use a code that comes back, or leave `roleCode` out for the default model. `HAIKU` is only an example: a code that does not exist makes every call answer `RecordNotFound`. Tables and fields of a `tableView`: `Help.Tables.Get` and `Help.Fields.Get`. A field in `@_current.fields.X` is written without spaces and without punctuation except `_`: `No.` is `No_`.');
        O.AppendLine('3. **Create the header and the steps with every step `Disabled = true`.** Put `"Disabled": true` in the `Data.Records.Set` call that creates each step. A disabled step is skipped, so nothing can run while you are still building. Create the conditions and the Result Log Paths now too.');
        O.AppendLine('4. **Run `Orchestrator.Playbook.Verify` and fix every finding.** It reads the playbook without running it, also while the steps are disabled. A finding has a `severity` (`error` or `warning`), the `stepNo`, a `code`, what is wrong (`message`) and what to do about it (`nextStep`). An error is always a mistake. A warning is a mistake unless you can say why this case is deliberate. Repeat until `findings` is empty.');
        O.AppendLine('5. **Run the read and decision steps only.** Enable the read steps and the `Check` steps and leave every write step disabled. Call `Orchestrator.Workspace.Preview` to see what `_sys`, `_who` and `_initial` hold, then `Orchestrator.Playbook.Run`, and read `Playbook Step Log ori` for the instance: request, response and `Check answered no.` for each record. Confirm that the decisions say yes and no for the records you expect. Verify again after every change.');
        O.AppendLine('6. **Enable the write steps one at a time**, starting with a filter that hits a single test record (for example `No.=CONST(10000)` in the read step). Run, read the step log, confirm that exactly that record changed, and verify again before you enable the next write step. Widen the filter last.');
        O.AppendLine('7. **Only then schedule the playbook** (`Orchestrator.Playbook.Schedule`, or the Schedule action on the Playbook Card). Scheduling verifies once more. It refuses a playbook with an error, and one with a warning unless the request says `"ignoreWarnings": true`; `ignoreWarnings` never waives an error.');
        O.AppendLine('');
        O.AppendLine('### What `Orchestrator.Playbook.Verify` checks');
        O.AppendLine('');
        O.AppendLine('Every step is checked, enabled or not; a finding about a disabled step carries `"stepDisabled": true` and never blocks a run. `Orchestrator.Playbook.Run` and the schedule refuse on the findings of enabled steps.');
        O.AppendLine('');
        O.AppendLine('| Code | Severity | Means |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `MessageTypeUnavailable` | error | The message type does not exist in this deployment, or is not enabled for this user in this company (a type that exists but is not enabled is not reported on a step with a Start condition, such as the Telegram notice in the examples) |');
        O.AppendLine('| `LanguageModelRoleNotFound` | error | The `roleCode` of an `LLM.*` step is not a language model of this company |');
        O.AppendLine('| `TemplateNotJson` | error | The request template is not a JSON object. The engine does not fail: it sends an empty request `{}` |');
        O.AppendLine('| `StepReferenceNotFound`, `StepReferenceNotEarlier` | error | An `@<stepNo>` reference (`@10.x`, `@collect:25`, `@10,20`) to a step that does not exist, or that does not run before this step |');
        O.AppendLine('| `CheckWithoutSuccessCondition` | error | A `Check` step has no Success condition, so it answers yes every time and decides nothing |');
        O.AppendLine('| `NextStepNotFound` | error | A `Next Step No.` edge points at a step that does not exist |');
        O.AppendLine('| `IterateSourceInvalid` | error | A forEach step iterates a step that does not exist or does not come before it |');
        O.AppendLine('| `InvalidSkipGate` | error | `Skip If Step Failed` names a step that does not exist, does not come first or does not iterate: every item would be skipped |');
        O.AppendLine('| `ScheduledWithErrors` | error | The playbook is scheduled and an enabled step has an error |');
        O.AppendLine('| `UnsafeForEachWrite` | warning | An enabled forEach write step follows a forEach `Check` over the same array and does not have `Skip If Step Failed` set to it: it writes for every item |');
        O.AppendLine('| `ActionWithoutSuccessCondition` | warning | An `Action` has no Success condition, so it counts as successful whenever the type does not raise, also when it answers `status: "Error"` |');
        O.AppendLine('| `AskForEachUnbounded` | warning | An Ask forEach reads records from a source with no `take`; paging does not bound cost |');
        O.AppendLine('| `AskDataConditionWithoutSchema` | warning | An Ask Success or Error condition reads `data` without `responseSchema` |');
        O.AppendLine('| `AskTraceDiscarded` | warning | Ask requests `includeTrace: true`, but Orchestrator discards the trace before using or storing the response |');
        O.AppendLine('| `ForEachSourceUnguarded` | warning | A record reader (`Data.Records.Get`) feeds a forEach but has no Success condition on `noOfRecords`: an empty answer still succeeds and the forEach does nothing |');
        O.AppendLine('| `UnknownFieldReference` | warning | `@_current.fields.X` names a field the source table does not have, or `@N.field` / `@N.@_iter.field` names a field step N does not store in its Result Log Paths |');
        O.AppendLine('');
        O.AppendLine('When `Orchestrator.Playbook.Run` or `Orchestrator.Playbook.Schedule` refuses, the answer is `PreconditionFailed` on `playbookCode`, the text lists the blocking findings, and `findings` holds them:');
        O.AppendLine('');
        O.AppendLine('```json');
        O.AppendLine('{ "status": "Error", "code": "PreconditionFailed",');
        O.AppendLine('  "error": "Playbook CUST-CREDIT-CTRL was not started: errors on enabled steps: 1, warnings: 0. Step 30 [LanguageModelRoleNotFound]: Step 30 calls LLM.Prompt.Complete with roleCode HAIKU, but this company has no language model with that code. ...",');
        O.AppendLine('  "parameter": "playbookCode", "received": "CUST-CREDIT-CTRL",');
        O.AppendLine('  "nextStep": "Call Orchestrator.Playbook.Verify with the same playbookCode, fix the findings, then call again. ...",');
        O.AppendLine('  "findings": [ { "severity": "error", "stepNo": 30, "code": "LanguageModelRoleNotFound", "message": "...", "nextStep": "..." } ] }');
        O.AppendLine('```');
        O.AppendLine('');
    end;

    local procedure BuildWorkedExamples(var O: TextBuilder)
    begin
        O.AppendLine('## Worked Playbook Examples');
        O.AppendLine('');
        O.AppendLine('Three complete playbooks. Each is created with three `Data.Records.Set` calls: the header, the steps, the conditions. `RequestTemplate` is the base64 of the JSON printed under each step table. The calls show the finished, enabled state to stay short: when you build, add `"Disabled": true` to every step as in "Building a playbook safely" and enable the steps as described there. Examples 1 and 2 verify with no findings; example 3 is the mistake on purpose and verifies with exactly one warning.');
        O.AppendLine('');
        O.AppendLine('### Example 1 — Per-record decision, then per-record write');
        O.AppendLine('');
        O.AppendLine('`CREDIT-CTRL` blocks every customer that has an overdue balance for invoicing, and tells the credit controller how many it checked and blocked. This is the shape that went wrong when the write had no gate: **decide per record, write per record**.');
        O.AppendLine('');
        O.AppendLine('**Header**');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook ori",');
        O.AppendLine('  "data": [{ "primaryKey": { "Code": "CREDIT-CTRL" },');
        O.AppendLine('    "fields": { "Description": "Block customers with an overdue balance and tell the credit controller" } }]');
        O.AppendLine('} }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('**Steps**');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook Step ori",');
        O.AppendLine('  "data": [');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 10 },');
        O.AppendLine('      "fields": { "Description": "Read the customers", "StepType": "Action", "MessageType": "Data.Records.Get",');
        O.AppendLine('        "RequestTemplate": "eyJ0YWJsZU5hbWUiOiJDdXN0b21lciIsImZpZWxkTnVtYmVycyI6WzEsMl0sInRhYmxlVmlldyI6IldIRVJFKEJsb2NrZWQ9Q09OU1QoICkpIn0=",');
        O.AppendLine('        "ResultLogPaths": "noOfRecords>customerCount", "NextStepNo_Success": 30 } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 30 },');
        O.AppendLine('      "fields": { "Description": "Does this customer have an overdue balance?", "StepType": "Check", "MessageType": "Data.Records.Get",');
        O.AppendLine('        "IterateSourceStepNo_": 10, "IterateArrayPath": "result",');
        O.AppendLine('        "RequestTemplate": "eyJ0YWJsZU5hbWUiOiJDdXN0b21lciIsImZpZWxkTnVtYmVycyI6WzFdLCJ0YWJsZVZpZXciOiJXSEVSRShOby49Q09OU1QoQF9jdXJyZW50LmZpZWxkcy5Ob18pLEJhbGFuY2UgRHVlIChMQ1kpPUZJTFRFUig+MCkpIn0=",');
        O.AppendLine('        "NextStepNo_Success": 40, "NextStepNo_Failure": 40 } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 40 },');
        O.AppendLine('      "fields": { "Description": "Block the customer for invoicing", "StepType": "Action", "MessageType": "Data.Records.Set",');
        O.AppendLine('        "IterateSourceStepNo_": 10, "IterateArrayPath": "result", "SkipIfStepFailed": 30,');
        O.AppendLine('        "RequestTemplate": "eyJ0YWJsZU5hbWUiOiJDdXN0b21lciIsImRhdGEiOlt7ImlkIjoiQF9jdXJyZW50LmlkIiwiZmllbGRzIjp7IkJsb2NrZWQiOiJJbnZvaWNlIn19XX0=",');
        O.AppendLine('        "NextStepNo_Success": 90, "NextStepNo_Failure": 90 } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 90 },');
        O.AppendLine('      "fields": { "Description": "Tell the credit controller", "StepType": "Action", "MessageType": "Orchestrator.Telegram.Message",');
        O.AppendLine('        "ExcludeFromRunStatus": true,');
        O.AppendLine('        "RequestTemplate": "eyJtZXNzYWdlIjoiQ3JlZGl0IGNvbnRyb2w6IEAxMC5jdXN0b21lckNvdW50IGN1c3RvbWVycyBjaGVja2VkLCBAX3N0ZXBzLjQwLml0ZW1zLnN1Y2NlZWRlZCBibG9ja2VkLiJ9" } }');
        O.AppendLine('  ] } }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('The templates, decoded:');
        O.AppendLine('');
        O.AppendLine('| Step | Template (JSON) |');
        O.AppendLine('|---|---|');
        O.AppendLine('| 10 | `{"tableName":"Customer","fieldNumbers":[1,2],"tableView":"WHERE(Blocked=CONST( ))"}` |');
        O.AppendLine('| 30 | `{"tableName":"Customer","fieldNumbers":[1],"tableView":"WHERE(No.=CONST(@_current.fields.No_),Balance Due (LCY)=FILTER(>0))"}` |');
        O.AppendLine('| 40 | `{"tableName":"Customer","data":[{"id":"@_current.id","fields":{"Blocked":"Invoice"}}]}` |');
        O.AppendLine('| 90 | `{"message":"Credit control: @10.customerCount customers checked, @_steps.40.items.succeeded blocked."}` |');
        O.AppendLine('');
        O.AppendLine('**Conditions** (one call, all five rows)');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook Condition ori",');
        O.AppendLine('  "data": [');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 10, "ConditionType": "Success", "GroupNo_": 1, "LineNo_": 10000 },');
        O.AppendLine('      "fields": { "Path": "status", "Operator": "Equals", "Value": "Success" } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 10, "ConditionType": "Success", "GroupNo_": 1, "LineNo_": 20000 },');
        O.AppendLine('      "fields": { "Path": "noOfRecords", "Operator": "GreaterThan", "Value": "0" } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 30, "ConditionType": "Success", "GroupNo_": 1, "LineNo_": 10000 },');
        O.AppendLine('      "fields": { "Path": "status", "Operator": "Equals", "Value": "Success" } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 30, "ConditionType": "Success", "GroupNo_": 1, "LineNo_": 20000 },');
        O.AppendLine('      "fields": { "Path": "noOfRecords", "Operator": "GreaterThan", "Value": "0" } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 40, "ConditionType": "Success", "GroupNo_": 1, "LineNo_": 10000 },');
        O.AppendLine('      "fields": { "Path": "status", "Operator": "Equals", "Value": "Success" } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 90, "ConditionType": "Start", "GroupNo_": 1, "LineNo_": 10000 },');
        O.AppendLine('      "fields": { "Path": "_who.telegramChatId", "Operator": "Exists", "Value": "" } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "CREDIT-CTRL", "StepNo_": 90, "ConditionType": "Success", "GroupNo_": 1, "LineNo_": 10000 },');
        O.AppendLine('      "fields": { "Path": "status", "Operator": "Equals", "Value": "Success" } }');
        O.AppendLine('  ] } }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('**Why every line is there**');
        O.AppendLine('');
        O.AppendLine('- **Step 10, `noOfRecords GreaterThan 0` beside `status Equals Success`.** A read that finds nothing still answers `Success`. Without the second condition step 30 and 40 would iterate zero customers, succeed, and the run would end `Completed` having done nothing. With it, an empty read fails step 10 and the run is `Failed` at the step that is really wrong. `Next Step No. (Failure)` is left at 0: the playbook ends there, no notice is sent. `Orchestrator.Playbook.Verify` warns (`ForEachSourceUnguarded`) when this condition is missing.');
        O.AppendLine('- **Step 10, the filter `Blocked=CONST( )`.** Only customers that are not blocked yet are candidates, so the playbook never replaces a stronger block (for example `All`) with `Invoice`.');
        O.AppendLine('- **Step 10, `ResultLogPaths: noOfRecords>customerCount`.** Stores the count at `10.customerCount` for the notice. The array itself needs no mapping: a forEach step reads the answer of its source step directly (`IterateSourceStepNo_` 10, `IterateArrayPath` `result`).');
        O.AppendLine('- **Step 30 is a `Check`, not an `Action`.** A customer without an overdue balance is not an error. A `Check` that answers no is logged `Cancelled` ("Check answered no."), does not increment `StepsFailed` and does not fail the run. The decision is a read that finds a row only when the rule holds (`Balance Due (LCY)` above 0 for exactly this customer, `@_current.fields.No_`), so the Success condition `noOfRecords GreaterThan 0` is the answer yes.');
        O.AppendLine('- **Step 30, both Next Step edges at 40.** A forEach step follows one edge once, after all its iterations. The edges can not make the decision per customer; they only have to lead on.');
        O.AppendLine('- **Step 40, `SkipIfStepFailed: 30`.** This is the gate. For each customer the step is skipped (`Cancelled`, "Skipped: prior step failed for this item.") unless step 30''s answer for the same customer was yes. Next Step edges do not do this: they apply once for the whole step. Without this one number step 40 would block every customer, which is example 3.');
        O.AppendLine('- **Step 40, the write by `id`.** `@_current.id` is the SystemId of the customer that the current iteration is on, so the write can only touch that customer. `Blocked` is written by its AL name, `Invoice`.');
        O.AppendLine('- **Step 40, the Success condition `status Equals Success`.** Without a Success condition an `Action` counts as successful whenever the type does not raise, also when it answers `status: "Error"` (`ActionWithoutSuccessCondition`).');
        O.AppendLine('- **Step 90 is the tail, `ExcludeFromRunStatus`.** The notice reports on the run, so it stays out of the totals it reports. The Start condition `_who.telegramChatId Exists` skips it for a user without a chat id instead of failing the run. `@_steps.40.items.succeeded` is how many customers step 40 wrote, which is not `itemsProcessed`.');
        O.AppendLine('');
        O.AppendLine('### Example 2 — A read-only reporting playbook');
        O.AppendLine('');
        O.AppendLine('`OVERDUE-REPORT` counts the customers with an overdue balance and sends the number. It writes nothing, so it needs no decision step and no gate; it is safe to schedule once it verifies.');
        O.AppendLine('');
        O.AppendLine('**Header and steps**');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook ori",');
        O.AppendLine('  "data": [{ "primaryKey": { "Code": "OVERDUE-REPORT" },');
        O.AppendLine('    "fields": { "Description": "Count customers with an overdue balance and send the number" } }]');
        O.AppendLine('} }');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook Step ori",');
        O.AppendLine('  "data": [');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "OVERDUE-REPORT", "StepNo_": 10 },');
        O.AppendLine('      "fields": { "Description": "Count the customers", "StepType": "Action", "MessageType": "Data.Records.Get",');
        O.AppendLine('        "RequestTemplate": "eyJ0YWJsZU5hbWUiOiJDdXN0b21lciIsImZpZWxkTnVtYmVycyI6WzEsMl0sInRhYmxlVmlldyI6IldIRVJFKEJhbGFuY2UgRHVlIChMQ1kpPUZJTFRFUig+MCkpIn0=",');
        O.AppendLine('        "ResultLogPaths": "noOfRecords>overdueCount", "NextStepNo_Success": 20, "NextStepNo_Failure": 20 } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "OVERDUE-REPORT", "StepNo_": 20 },');
        O.AppendLine('      "fields": { "Description": "Send the number", "StepType": "Action", "MessageType": "Orchestrator.Telegram.Message",');
        O.AppendLine('        "RequestTemplate": "eyJtZXNzYWdlIjoiQ3VzdG9tZXJzIHdpdGggYW4gb3ZlcmR1ZSBiYWxhbmNlOiBAMTAub3ZlcmR1ZUNvdW50In0=" } }');
        O.AppendLine('  ] } }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('Templates: step 10 `{"tableName":"Customer","fieldNumbers":[1,2],"tableView":"WHERE(Balance Due (LCY)=FILTER(>0))"}`; step 20 `{"message":"Customers with an overdue balance: @10.overdueCount"}`.');
        O.AppendLine('');
        O.AppendLine('**Conditions**: step 10 `Success` `status Equals Success`; step 20 `Start` `_who.telegramChatId Exists` and `Success` `status Equals Success`, written as the rows in example 1 (`LineNo_` 10000, `GroupNo_` 1).');
        O.AppendLine('');
        O.AppendLine('Why it is safe: there is no write step, so nothing needs a gate. An empty read is a legitimate answer here ("0 customers"), so step 10 has no `noOfRecords` condition and nothing iterates its result. The count is stored with `ResultLogPaths` and read with `@10.overdueCount`; `Orchestrator.Playbook.Verify` checks that step 10 really stores `overdueCount`.');
        O.AppendLine('');
        O.AppendLine('### Example 3 — The anti-pattern: an ungated forEach write');
        O.AppendLine('');
        O.AppendLine('**Do not build this.** It is example 1 with one number changed on step 40: `SkipIfStepFailed` is 0 (or left out).');
        O.AppendLine('');
        O.AppendLine('```json');
        O.AppendLine('{ "primaryKey": { "PlaybookCode": "CUST-BLOCK-ALL", "StepNo_": 40 },');
        O.AppendLine('  "fields": { "Description": "Block the customer for invoicing", "StepType": "Action", "MessageType": "Data.Records.Set",');
        O.AppendLine('    "IterateSourceStepNo_": 10, "IterateArrayPath": "result", "SkipIfStepFailed": 0,');
        O.AppendLine('    "RequestTemplate": "eyJ0YWJsZU5hbWUiOiJDdXN0b21lciIsImRhdGEiOlt7ImlkIjoiQF9jdXJyZW50LmlkIiwiZmllbGRzIjp7IkJsb2NrZWQiOiJJbnZvaWNlIn19XX0=" } }');
        O.AppendLine('```');
        O.AppendLine('');
        O.Append('What it does: step 30 runs for every customer and answers yes or no for each. Then step 40 runs for every customer, because nothing tells it to look at step 30''s answer: `Next Step No. (Success)` and `Next Step No. (Failure)` are followed once for the whole of step 30, not once per customer. **Every customer in the read is blocked for invoicing**, the ones with an overdue balance and the ones without, and each write is committed. The run ends `Completed`, and the step log of step 30 even shows "Check answered no." for the customers that were blocked anyway. ');
        O.AppendLine('`Orchestrator.Playbook.Verify` answers one warning, `UnsafeForEachWrite` on step 40 with `checkStepNo` 30, and `Orchestrator.Playbook.Run` refuses the playbook until you set `SkipIfStepFailed` to 30 (or pass `ignoreWarnings`, which you should not).');
        O.AppendLine('');
        O.AppendLine('### A decision that needs judgement');
        O.AppendLine('');
        O.AppendLine('When the rule cannot be written as a filter, make step 30 an LLM `Check`: message type `LLM.Prompt.Complete`, template `{"roleCode":"<a code that exists in Bifrost Language Model ori>","system":"Answer ONLY BLOCK or NO.","prompt":"Customer: @_current.fields.Name ..."}` and Success conditions `status Equals Success` and `text Equals BLOCK`. Everything else stays: step 40 keeps `SkipIfStepFailed: 30`. Check the `roleCode` first (step 2 of "Building a playbook safely"): `Orchestrator.Playbook.Verify` reports `LanguageModelRoleNotFound` for a code that does not exist, and an error answer from the model (an unknown role, a provider that is down) fails the Check instead of being read as "no".');
        O.AppendLine('');
    end;

    local procedure BuildPlaybookWorkflowGuide(var O: TextBuilder)
    begin
        O.AppendLine('## Playbook Workflow Engine — Concepts');
        O.AppendLine('');
        O.AppendLine('A **Playbook** is a named sequence of message type calls with data flow through a shared **Workspace**.');
        O.AppendLine('');
        O.AppendLine('### Execution Model');
        O.AppendLine('');
        O.AppendLine('- Each step calls one Bifrost message type');
        O.AppendLine('- Steps execute sequentially; each step''s writes commit independently');
        O.AppendLine('- **No rollback** of previous steps on failure');
        O.AppendLine('- Steps branch on success/failure via `Next Step No. (Success)` / `Next Step No. (Failure)`');
        O.AppendLine('- Step 0 as next = end playbook (success or failure depending on path)');
        O.AppendLine('- Full request/response logged per step for audit and replay');
        O.AppendLine('');
        O.AppendLine('### Data Flow — Workspace + @Templates');
        O.AppendLine('');
        O.AppendLine('All data flows through a **single JSON workspace document**. Two phases:');
        O.AppendLine('');
        O.AppendLine('**Phase 1 — Gather:** Steps execute and write results to workspace via `Result Log Paths`.');
        O.AppendLine('Data is keyed by step number (and iteration number for forEach):');
        O.AppendLine('- Single step: `<StepNo>.<fieldName>` (e.g. `10.company`)');
        O.AppendLine('- forEach step: `<StepNo>.<IterationNo>.<fieldName>` (e.g. `20.0.valid`, `20.1.valid`)');
        O.AppendLine('- Initial request: stored at `_initial` (e.g. `_initial.invoiceNo`)');
        O.AppendLine('- Current forEach element: stored at `_current` during each iteration');
        O.AppendLine('- System constants: stored at `_sys` (dates, company, user)');
        O.AppendLine('- WhoAmI context: stored at `_who` (user profile, salesperson, company info)');
        O.AppendLine('');
        O.AppendLine('**Phase 2 — Build:** Request templates use `@path` references resolved from workspace:');
        O.AppendLine('');
        O.AppendLine('| Syntax | Resolves to | Example |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `"@path"` | Single value/object/array (type-preserving) | `"@10.company.fields.Name"` → `"CRONUS Ltd."` |');
        O.AppendLine('| `"@_current.field"` | Current forEach element field | `"@_current.fields.No_"` → `"10000"` |');
        O.AppendLine('| `"@_initial.key"` | Initial request parameter | `"@_initial.invoiceNo"` → `"103002"` |');
        O.AppendLine('| `"@_iter"` | Current forEach iteration index | `"@30.@_iter.street"` → resolves to `"@30.0.street"` then to the value |');
        O.AppendLine('| `"@_sys.field"` | System constant | `"@_sys.today"` → `"2026-08-30"`, `"@_sys.lastMonthStart"` → `"2026-07-01"` |');
        O.AppendLine('| `"@_who.path"` | WhoAmI user/company context | `"@_who.salesperson.email"` → `"user@company.is"` |');
        O.AppendLine('| `"@collect:N"` | All iterations of step N as array | `"@collect:25"` → `[{...}, {...}]` |');
        O.AppendLine('| `"@k1,k2,k3"` | Filtered workspace dump (escaped string) | `"@10,20,30"` → `"{\"10\":...}"` |');
        O.AppendLine('| `@path` (embedded) | Text interpolation within a string | `"WHERE(No.=CONST(@_initial.id))"` |');
        O.AppendLine('');
        O.AppendLine('Numeric strings are auto-detected and injected as JSON numbers.');
        O.AppendLine('');
        O.AppendLine('### Result Log Paths');
        O.AppendLine('');
        O.AppendLine('The `Result Log Paths` field controls what data each step writes to workspace.');
        O.AppendLine('Comma-separated, supports `source>target` renaming:');
        O.AppendLine('');
        O.AppendLine('| Syntax | Source in response | Stored at (single step 10) |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `result` | `result` | `10.result` |');
        O.AppendLine('| `result>customers` | `result` | `10.customers` |');
        O.AppendLine('| `result[0]>invoice` | First element of `result` | `10.invoice` (no array wrapper) |');
        O.AppendLine('| `result.valid>valid` | `result.valid` | `10.valid` |');
        O.AppendLine('');
        O.AppendLine('### ForEach Iteration');
        O.AppendLine('');
        O.AppendLine('A step with `Iterate Array Path` set becomes a foreach loop:');
        O.AppendLine('- Extracts an array from a prior step''s response (via ResponseStore)');
        O.AppendLine('- Executes the message type once per array element');
        O.AppendLine('- `@_current` in the request template resolves to the current element');
        O.AppendLine('- `Stop On Item Error` controls whether to abort on first failure');
        O.AppendLine('- Each iteration writes to workspace at `<StepNo>.<IterationNo>.<field>`');
        O.AppendLine('- The iterator element is also stored at `<StepNo>.<IterationNo>._item`');
        O.AppendLine('- Use `@collect:N` to gather all iterations into an array');
        O.AppendLine('');
        O.AppendLine('### Per-item decisions in a forEach');
        O.AppendLine('');
        O.AppendLine('`Next Step No. (Success)` and `Next Step No. (Failure)` are followed **once per step, not once per item**. A forEach');
        O.AppendLine('step runs all of its iterations first and then follows exactly one edge, so a forEach `Check` cannot decide, item by');
        O.AppendLine('item, which items a later forEach step writes to. Left alone, the later step writes to every item.');
        O.AppendLine('');
        O.AppendLine('The per-item gate is `Skip If Step Failed = <check step no>` on every downstream forEach step that must be');
        O.AppendLine('conditional. The step is skipped (`Cancelled`, `Skipped: prior step failed for this item.`) for each iteration in');
        O.AppendLine('which the named step''s same iteration did not succeed, an answer of no included.');
        O.AppendLine('');
        O.AppendLine('Worked example: block the customers a language model answers `BLOCK` for, unblock the ones it answers `NO` for.');
        O.AppendLine('All forEach steps iterate step 10''s `result`:');
        O.AppendLine('');
        O.AppendLine('| Step | Message type | Step Type | Iterate Source Step No. | Iterate Array Path | Skip If Step Failed | Success condition |');
        O.AppendLine('|---|---|---|---|---|---|---|');
        O.AppendLine('| 10 | `Data.Records.Get` (customers) | Action | 0 | | 0 | `status Equals Success` |');
        O.AppendLine('| 30 | `LLM.Prompt.Complete` (BLOCK or NO) | Check | 10 | `result` | 0 | `text Equals BLOCK` |');
        O.AppendLine('| 40 | `Data.Records.Set` (`Blocked` = `Invoice`) | Action | 10 | `result` | **30** | `status Equals Success` |');
        O.AppendLine('| 50 | `LLM.Prompt.Complete` (BLOCK or NO) | Check | 10 | `result` | 0 | `text Equals NO` |');
        O.AppendLine('| 60 | `Data.Records.Set` (`Blocked` = empty) | Action | 10 | `result` | **50** | `status Equals Success` |');
        O.AppendLine('');
        O.AppendLine('Step 40 runs only for the customers step 30 answered `BLOCK` for, and step 60 only for the customers step 50');
        O.AppendLine('answered `NO` for. With `Skip If Step Failed = 0` on step 40, step 40 writes `Blocked = Invoice` to every customer.');
        O.AppendLine('`Orchestrator.Playbook.Verify` warns about exactly that configuration.');
        O.AppendLine('');
        O.AppendLine('### Conditions');
        O.AppendLine('');
        O.AppendLine('Steps can evaluate the response to determine success/failure:');
        O.AppendLine('Conditions live in `Playbook Condition ori`, keyed by playbook, step, type, group and line.');
        O.AppendLine('');
        O.AppendLine('| Type | Evaluated | Against | Effect |');
        O.AppendLine('|---|---|---|---|');
        O.AppendLine('| `Start` | before the step | workspace | False = step is Cancelled, chain follows the success path |');
        O.AppendLine('| `Success` | after the step | response | Picks the success or failure branch |');
        O.AppendLine('| `Error` | after the step | workspace | True = mark the run failed, branch unchanged |');
        O.AppendLine('');
        O.AppendLine('**All conditions in a group must hold. Any group holding is enough.**');
        O.AppendLine('AND within a `Group No.`, OR across groups — every boolean expression can be');
        O.AppendLine('written that way, so there is no nesting, precedence or parentheses to learn.');
        O.AppendLine('An empty condition set is true.');
        O.AppendLine('');
        O.AppendLine('```');
        O.AppendLine('Type   Group  Path                       Operator   Value');
        O.AppendLine('Start  1      _run.failed                Equals     true');
        O.AppendLine('Start  2      _steps.30.items.succeeded  Equals     0');
        O.AppendLine('Start  2      _steps.30.status           NotEquals  Cancelled');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('Operators: Equals, NotEquals, Contains, GreaterThan, LessThan, GreaterOrEqual, LessOrEqual, Exists.');
        O.AppendLine('');
        O.AppendLine('### `status Equals Success` is not enough');
        O.AppendLine('');
        O.AppendLine('A message type reports `Success` when it did what was asked, and finding nothing is');
        O.AppendLine('doing what was asked. `Data.Records.Get` over a filter that matches no rows returns');
        O.AppendLine('`{"status":"Success","noOfRecords":0,"result":[]}`. A step guarded only on `status`');
        O.AppendLine('accepts that, the forEach below it iterates zero times and also succeeds, and the run');
        O.AppendLine('ends Completed having done nothing — with the real cause several steps upstream.');
        O.AppendLine('');
        O.AppendLine('Add the second condition in the same group, so both must hold:');
        O.AppendLine('');
        O.AppendLine('```');
        O.AppendLine('Type     Group  Line   Path          Operator      Value');
        O.AppendLine('Success  1      10000  status        Equals        Success');
        O.AppendLine('Success  1      20000  noOfRecords   GreaterThan   0');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('Then decide what an empty result *means*. If the playbook has nothing to do when the');
        O.AppendLine('query is empty, that is a `Check` step — it routes down the failure edge to a tidy');
        O.AppendLine('ending without marking the run failed. If an empty result means something upstream is');
        O.AppendLine('broken, leave it an `Action` so the run fails and names this step.');
        O.AppendLine('');
        O.AppendLine('### Step Type — checks are not errors');
        O.AppendLine('');
        O.AppendLine('- `Action` (default): a false Success condition means the step failed, and the run fails.');
        O.AppendLine('- `Check`: a false Success condition is simply the answer. It still routes down the');
        O.AppendLine('  failure path and still drives `Skip If Step Failed`, but it does **not** fail the run.');
        O.AppendLine('');
        O.AppendLine('A `Check` can end two different ways, and the log tells them apart:');
        O.AppendLine('');
        O.AppendLine('| Outcome | Step log status | Step log `ErrorText` | `_steps.<no>.items` | Fails the run? |');
        O.AppendLine('|---|---|---|---|---|');
        O.AppendLine('| Answered no (response `status: "Success"`, Success condition false) | `Cancelled` (forEach) or `Completed` (single step) | `Check answered no.` | `checkFailed` | No |');
        O.AppendLine('| Failed (the message type raised an error or answered `status: "Error"`) | `Failed` | the type''s `code` and `error` | `failed` and `errored` | Yes, as an `Action` would |');
        O.AppendLine('');
        O.AppendLine('A failed `Check` never reaches its Success conditions: an error answer is not an answer. It increments');
        O.AppendLine('`StepsFailed`, fails the run, and keeps the error text (cut to 500 characters in `_steps.<no>.failures[].error`).');
        O.AppendLine('');
        O.AppendLine('Use `Check` for validations and predicates — "is this kennitala valid", "did the');
        O.AppendLine('address match", "are there any documents to import". A step asking a question and');
        O.AppendLine('getting "no" has not failed.');
        O.AppendLine('- If no condition set, step succeeds whenever the message type doesn''t throw an error');
        O.AppendLine('');
    end;

    local procedure BuildDataRecordsGuide(var O: TextBuilder)
    begin
        O.AppendLine('## Building Workflows via Data.Records.Set/Get');
        O.AppendLine('');
        O.AppendLine('### Tables');
        O.AppendLine('');
        O.AppendLine('| Table | Purpose | Primary Key |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `Playbook ori` | Playbook header (name, schedule, template) | Code[20] |');
        O.AppendLine('| `Playbook Step ori` | Step definition (message type, template, branching) | (PlaybookCode, StepNo_) |');
        O.AppendLine('| `Playbook Condition ori` | Start/Success/Error conditions, one row per condition | (PlaybookCode, StepNo_, ConditionType, GroupNo_, LineNo_) |');
        O.AppendLine('| `Recurring Template ori` | Reusable schedule template (days, time, interval) | Code[20] |');
        O.AppendLine('| `Playbook Instance ori` | Execution log (per run) | ID (Guid) |');
        O.AppendLine('| `Playbook Step Log ori` | Per-step execution detail | (Instance ID, Step No., Iteration No.) |');
        O.AppendLine('');
        O.AppendLine('### Example: E-Document Send Playbook (BII1 invoice via Advania)');
        O.AppendLine('');
        O.AppendLine('**Step 1: Create the playbook**');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook ori",');
        O.AppendLine('  "data": [{ "primaryKey": { "Code": "EDOC-SEND" },');
        O.AppendLine('    "fields": { "Description": "Send invoice via Advania" } }]');
        O.AppendLine('} }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('**Step 2: Add steps with request templates**');
        O.AppendLine('Request templates are BLOB fields — pass base64-encoded JSON:');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook Step ori",');
        O.AppendLine('  "data": [');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "EDOC-SEND", "StepNo_": 10 },');
        O.AppendLine('      "fields": { "Description": "Get company info",');
        O.AppendLine('        "MessageType": "Data.Records.Get",');
        O.AppendLine('        "RequestTemplate": "<base64 of {\"tableName\":\"Company Information\",...}>",');
        O.AppendLine('        "ResultLogPaths": "result[0]>company",');
        O.AppendLine('        "NextStepNo_Success": 20 } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "EDOC-SEND", "StepNo_": 20 },');
        O.AppendLine('      "fields": { "Description": "Render BII1 XML",');
        O.AppendLine('        "MessageType": "DocumentExchange.UBL.RenderBilling",');
        O.AppendLine('        "RequestTemplate": "<base64 of template with @10.company.fields.Name etc>",');
        O.AppendLine('        "ResultLogPaths": "xml,success" } }');
        O.AppendLine('  ] } }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('**Step 3: Run with parameters**');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Orchestrator.Playbook.Run", "data": {');
        O.AppendLine('  "playbookCode": "EDOC-SEND",');
        O.AppendLine('  "initialRequest": { "invoiceNo": "103002" } } }');
        O.AppendLine('```');
        O.AppendLine('The `initialRequest` is stored in workspace at `_initial`, accessible as `@_initial.invoiceNo`.');
        O.AppendLine('');
        O.AppendLine('### Writing conditions');
        O.AppendLine('');
        O.AppendLine('Conditions are ordinary records. One row per condition, `Line No.` spaced like step');
        O.AppendLine('numbers so rows can be inserted between:');
        O.AppendLine('');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook Condition ori",');
        O.AppendLine('  "data": [');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "EDOC-SEND", "StepNo_": 10,');
        O.AppendLine('        "ConditionType": "Success", "GroupNo_": 1, "LineNo_": 10000 },');
        O.AppendLine('      "fields": { "Path": "status", "Operator": "Equals", "Value": "Success" } },');
        O.AppendLine('    { "primaryKey": { "PlaybookCode": "EDOC-SEND", "StepNo_": 10,');
        O.AppendLine('        "ConditionType": "Success", "GroupNo_": 1, "LineNo_": 20000 },');
        O.AppendLine('      "fields": { "Path": "noOfRecords", "Operator": "GreaterThan", "Value": "0" } }');
        O.AppendLine('  ] } }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('**Write enum fields by their AL name, not their caption.** `Operator` accepts');
        O.AppendLine('`NotEquals`, `GreaterOrEqual`, `LessOrEqual`; it rejects `Not Equals`. `ConditionType`');
        O.AppendLine('accepts `Start`, `Success`, `Error`. `Step Type` accepts `Action`, `Check`.');
        O.AppendLine('');
        O.AppendLine('**A `Data.Records.Get` on these tables gives back captions, not names.** An is-IS');
        O.AppendLine('session reads `Operator: "Ekki jafnt"`, `ConditionType: "Upphaf"`. Requesting');
        O.AppendLine('`lcid: 1033` does not fix it: the English caption for `NotEquals` is `Not Equals`,');
        O.AppendLine('with a space, and `Set` rejects that too. Some names and captions coincide —');
        O.AppendLine('`Equals`, `Exists`, `Start` — which makes the failure look intermittent.');
        O.AppendLine('');
        O.AppendLine('So a read-modify-write cycle over conditions cannot feed its own output back in.');
        O.AppendLine('Map captions to AL names yourself, or keep the intended values beside the code that');
        O.AppendLine('writes them rather than recovering them from a Get.');
        O.AppendLine('');
    end;

    local procedure BuildSchedulingGuide(var O: TextBuilder)
    begin
        O.AppendLine('## Scheduling Playbooks for Recurring Execution');
        O.AppendLine('');
        O.AppendLine('Playbooks can run on a recurring schedule via the Job Queue. Two approaches:');
        O.AppendLine('');
        O.AppendLine('### Option A: Use a Recurring Template (recommended)');
        O.AppendLine('');
        O.AppendLine('Templates define reusable schedules (days, time window, interval).');
        O.AppendLine('');
        O.AppendLine('**1. Create or find a template:**');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Get", "data": { "tableName": "Recurring Template ori" } }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('**2. Create a template if needed:**');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Recurring Template ori",');
        O.AppendLine('  "data": [{ "primaryKey": { "Code": "WORKDAYS" },');
        O.AppendLine('    "fields": { "Description": "Weekdays 08-18 every 30 min",');
        O.AppendLine('      "RunonMondays": true, "RunonTuesdays": true, "RunonWednesdays": true,');
        O.AppendLine('      "RunonThursdays": true, "RunonFridays": true,');
        O.AppendLine('      "RunonSaturdays": false, "RunonSundays": false,');
        O.AppendLine('      "StartingTime": "08:00:00", "EndingTime": "18:00:00",');
        O.AppendLine('      "No_ofMinutesbetweenRuns": 30 } }]');
        O.AppendLine('} }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('**3. Assign template to playbook (auto-copies schedule fields):**');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook ori",');
        O.AppendLine('  "data": [{ "primaryKey": { "Code": "MY-PLAYBOOK" },');
        O.AppendLine('    "fields": { "RecurringTemplateCode": "WORKDAYS" } }]');
        O.AppendLine('} }');
        O.AppendLine('```');
        O.AppendLine('When a template is set, the playbook''s schedule fields (days, times, interval) are');
        O.AppendLine('automatically populated from the template and locked from manual editing.');
        O.AppendLine('');
        O.AppendLine('### Option B: Set schedule directly on the playbook');
        O.AppendLine('');
        O.AppendLine('```json');
        O.AppendLine('{ "type": "Data.Records.Set", "data": {');
        O.AppendLine('  "tableName": "Playbook ori",');
        O.AppendLine('  "data": [{ "primaryKey": { "Code": "MY-PLAYBOOK" },');
        O.AppendLine('    "fields": { "RunonMondays": true, "RunonTuesdays": true,');
        O.AppendLine('      "RunonWednesdays": true, "RunonThursdays": true, "RunonFridays": true,');
        O.AppendLine('      "StartingTime": "06:00:00", "EndingTime": "22:00:00",');
        O.AppendLine('      "No_ofMinutesbetweenRuns": 60 } }]');
        O.AppendLine('} }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('### Activating the schedule');
        O.AppendLine('');
        O.AppendLine('After setting the schedule, use the **Schedule** action on the Playbook Card page');
        O.AppendLine('to create the Job Queue Entry. This creates a recurring JQ Entry pointing to the');
        O.AppendLine('Bifrost Playbook JQ Dispatcher codeunit with the playbook''s RecordId.');
        O.AppendLine('');
        O.AppendLine('**Key playbook fields for scheduling:**');
        O.AppendLine('');
        O.AppendLine('| Field | Type | Purpose |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `RecurringTemplateCode` | Code[20] | Links to JQ Recurring Template (optional) |');
        O.AppendLine('| `No_ofMinutesbetweenRuns` | Integer | Run interval in minutes |');
        O.AppendLine('| `RunonMondays`..`RunonSundays` | Boolean | Which days to run |');
        O.AppendLine('| `StartingTime` | Time | Earliest time of day |');
        O.AppendLine('| `EndingTime` | Time | Latest time of day |');
        O.AppendLine('| `Scheduled` | Boolean (FlowField) | Whether a JQ Entry exists (read-only) |');
        O.AppendLine('| `JobQueueEntryID` | Guid | The created JQ Entry ID (read-only) |');
        O.AppendLine('');
    end;

    local procedure BuildLLMPatternsGuide(var O: TextBuilder)
    begin
        O.AppendLine('## Using LLM.Prompt.Complete in Playbooks');
        O.AppendLine('');
        O.AppendLine('`LLM.Prompt.Complete` is the general-purpose AI step for tasks not covered by dedicated message types.');
        O.AppendLine('Always set `roleCode` in the request template to control cost and speed (e.g. `HAIKU` for simple tasks), and only to a code that exists in this company: read the codes with `Data.Records.Get` on table `Bifrost Language Model ori`. A code that does not exist makes every call answer `RecordNotFound`, and `Orchestrator.Playbook.Verify` reports it as `LanguageModelRoleNotFound`.');
        O.AppendLine('');
        O.AppendLine('### Pattern 1: Yes/No Gate (per-item decision)');
        O.AppendLine('');
        O.AppendLine('Use LLM as a forEach decision step. The success condition determines the branch:');
        O.AppendLine('');
        O.AppendLine('```json');
        O.AppendLine('// Step 35 template — forEach, condition: text Contains "No"');
        O.AppendLine('{ "roleCode": "HAIKU",');
        O.AppendLine('  "system": "Compare two addresses. Answer ONLY Yes or No.",');
        O.AppendLine('  "prompt": "BC: @_current.fields.Address, @_current.fields.PostCode\\nRegistry: @30.@_iter.street, @30.@_iter.postCode" }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('- Condition `text Contains "No"` → mismatch = Completed → downstream step runs');
        O.AppendLine('- Condition false ("Yes") → Cancelled → downstream `Skip If Step Failed` skips it');
        O.AppendLine('- Use `@_iter` to reference same-iteration data from prior forEach steps');
        O.AppendLine('');
        O.AppendLine('### Pattern 2: Text Formatting (summary/report generation)');
        O.AppendLine('');
        O.AppendLine('Collect workspace data from multiple steps and format for output:');
        O.AppendLine('');
        O.AppendLine('```json');
        O.AppendLine('// Step 48 template — single step, workspace dump');
        O.AppendLine('{ "roleCode": "HAIKU",');
        O.AppendLine('  "system": "Create a report for Telegram. Use only <b>, <i> tags. No <p>, <table>.",');
        O.AppendLine('  "prompt": "@10,20,30" }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('- `@10,20,30` dumps filtered workspace data from steps 10, 20, 30 as a single string');
        O.AppendLine('- Always specify output constraints (Telegram tags, max chars, JSON-only, etc.)');
        O.AppendLine('- Store result via `ResultLogPaths: text>report` for downstream steps');
        O.AppendLine('');
        O.AppendLine('### Pattern 3: Run Notification');
        O.AppendLine('');
        O.AppendLine('Turn the run report into a human message. Do not describe the format — **show it**,');
        O.AppendLine('then show one filled-in example. A prompt that only lists rules produces output of');
        O.AppendLine('roughly the right shape and reliably the wrong length; the same prompt with a worked');
        O.AppendLine('example produces the shape exactly:');
        O.AppendLine('');
        O.AppendLine('The `system` string, written out (each line below is a real newline in the JSON):');
        O.AppendLine('');
        O.AppendLine('```text');
        O.AppendLine('JSON about an automated process that SUCCEEDED. Icelandic, for Telegram.');
        O.AppendLine('Format, exactly three lines:');
        O.AppendLine('OK <b>PLAYBOOK CODE</b>');
        O.AppendLine('<one sentence about what was achieved, with figures>');
        O.AppendLine('<i>x steps - y s</i>');
        O.AppendLine('Example:');
        O.AppendLine('OK <b>CUST-KT-SYNC</b>');
        O.AppendLine('5 customers checked, 4 valid kennitalas, 2 addresses updated.');
        O.AppendLine('<i>7 steps - 12 s</i>');
        O.AppendLine('Rules: use ONLY <b> and <i>, no other HTML and no Markdown asterisks. Real');
        O.AppendLine('line breaks, not <br>. durationMs is in MILLISECONDS - convert to seconds.');
        O.AppendLine('Take figures from _steps.*.result. No greeting, no signature.');
        O.AppendLine('Return ONLY the message.');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('and the step template that carries it:');
        O.AppendLine('');
        O.AppendLine('```json');
        O.AppendLine('// Step 900 - Start: _run.failed Equals false, Exclude From Run Status');
        O.AppendLine('{ "roleCode": "HAIKU", "system": "<the text above>", "prompt": "@_run,_steps" }');
        O.AppendLine('```');
        O.AppendLine('');
        O.AppendLine('Then `Result Log Paths: text>noticeText`, and send it from the next step with');
        O.AppendLine('`{"message":"@900.noticeText"}`. Failure notices are the same with `_run.failed`');
        O.AppendLine('inverted and `_run.firstFailedStepNo` named in the prompt.');
        O.AppendLine('');
        O.AppendLine('Four things the model gets wrong unless told:');
        O.AppendLine('');
        O.AppendLine('- **`durationMs` is milliseconds.** Unprompted it reports 41230 seconds.');
        O.AppendLine('- **`itemsProcessed` is iterations, not items.** Point the prompt at a named step.');
        O.AppendLine('- **Length.** State the limit *and* show it. SMS in Icelandic is UCS-2: 70 characters');
        O.AppendLine('  in one segment, 67 each once it splits — not the 160 of GSM-7 English.');
        O.AppendLine('- **Markup.** Telegram takes `<b> <i> <code> <a>`; anything else is a 400 from the');
        O.AppendLine('  API, so forbid other tags and Markdown asterisks explicitly.');
        O.AppendLine('');
        O.AppendLine('Pick the role for the job. A small local model is fine for a Yes/No gate but writes');
        O.AppendLine('unidiomatic Icelandic and leaks its instructions into prose; `HAIKU` composes these');
        O.AppendLine('notices in about 1.5 seconds. Latency compounds — a per-item LLM gate in a forEach');
        O.AppendLine('over a slow local model turned a 12-second run into 397 seconds.');
        O.AppendLine('');
        O.AppendLine('### Key Rules for LLM Steps');
        O.AppendLine('');
        O.AppendLine('1. **Choose an existing `roleCode` for Complete steps** — `HAIKU` for simple tasks (fast, cheap), larger models only when needed. Check the code with `Data.Records.Get` on `Bifrost Language Model ori` before you use it');
        O.AppendLine('2. **Always set success condition** — `status = Success` catches provider errors');
        O.AppendLine('3. **Constrain output format, and show the shape** — "Answer ONLY Yes/No", "Return ONLY JSON". For anything with a length limit, give the limit and a worked example of it; a rule alone is not enough');
        O.AppendLine('4. **Telegram-safe HTML** — only `<b>`, `<i>`, `<code>`, `<a>` tags. No `<p>`, `<table>`, `<div>`');
        O.AppendLine('5. **Response fields depend on the type** — `LLM.Prompt.Complete` returns `text`; `LLM.Prompt.Ask` returns `answer` and, with `responseSchema`, structured `data`. Use the corresponding Result Log Paths.');
        O.AppendLine('6. **Ask verdicts need a schema** — set `responseSchema` and test `schemaValid` as well as `data.verdict`. Verify warns with `AskDataConditionWithoutSchema` for Success or Error conditions on `data` without a schema.');
        O.AppendLine('7. **Bound an Ask forEach** — put `take` on its source record reader. Paging bounds memory per page, not the number of Ask runs. Every tool call Ask makes is a counted message; Verify warns with `AskForEachUnbounded` when the source has no `take`. Safe default limits do not trigger a warning.');
        O.AppendLine('8. **Ask traces cannot be used in a playbook** — Orchestrator removes `trace` before its logs, workspace and summaries use the response, and Verify warns with `AskTraceDiscarded` for `includeTrace: true`. Orchestrator stores no trace. Bifrost''s message log keeps the request and response of every message until retention deletes it.');
        O.AppendLine('9. **Ask is read-only** — it cannot call other language model or playbook types. `roleCode` is optional (the caller''s or default model); when supplied, it must exist in this company.');
        O.AppendLine('');
    end;

    local procedure BuildAgentRules(var O: TextBuilder)
    begin
        O.AppendLine('## Rules for AI Agents');
        O.AppendLine('');
        O.AppendLine('1. **Build with every step disabled.** Create the playbook and its steps with `Disabled = true`, enable the read and decision steps first, and enable the write steps one at a time on a single test record. See "Building a playbook safely".');
        O.AppendLine('2. **Verify before every run, and before every schedule.** Call `Orchestrator.Playbook.Verify` after every change and fix every finding. `Orchestrator.Playbook.Run` and `Orchestrator.Playbook.Schedule` verify again and refuse with `PreconditionFailed` when an enabled step has an error, or a warning unless `ignoreWarnings` is true. Never pass `ignoreWarnings` to get past a warning you do not understand.');
        O.AppendLine('3. **Never write in a forEach without a per-record gate.** Every forEach write step that follows a forEach `Check` over the same array must set `Skip If Step Failed` to that `Check`. The Next Step edges apply once per step, not per item; without the gate the write runs for every item. See "Per-item decisions in a forEach" and the worked example "Per-record decision, then per-record write".');
        O.AppendLine('4. **Check that every message type and every role code you name exists.** `describe_message_type` or `Help.Implementation.Get` for a message type; `Data.Records.Get` on `Bifrost Language Model ori` for the `roleCode` of an `LLM.*` step. A code you remember or guess (`HAIKU`) may not exist in this company.');
        O.AppendLine('5. **Use Data.Records.Get/Set for all CRUD** — reading/writing playbooks, steps, templates, credentials');
        O.AppendLine('6. **Use action message types for operations** — Run, Restart, Schedule, etc.');
        O.AppendLine('7. **Always check logs after Run** — read Playbook Instance ori and Playbook Step Log ori to verify');
        O.AppendLine('8. **Step numbering convention** — use 10, 20, 30... (allows inserting steps between)');
        O.AppendLine('9. **Request templates use `@path` syntax** — all data flows through the workspace, no separate bindings');
        O.AppendLine('10. **Request templates are BLOB fields** — set via Data.Records.Set by passing base64-encoded JSON as the field value');
        O.AppendLine('11. **Commits are permanent** — posting, document exchange, and other write operations cannot be undone by the engine');
        O.AppendLine('12. **Use `result[0]>name` in Result Log Paths** for single-record steps to avoid array wrapper in workspace');
        O.AppendLine('13. **Always add a Success condition** — one `Playbook Condition ori` row per step with `ConditionType=Success`, `Path=status`, `Operator=Equals`, `Value=Success` catches application-level errors. Set `StepType=Check` when a false answer is a legitimate result rather than a failure');
        O.AppendLine('14. **Use `@_iter` for cross-step forEach data** — in forEach templates, `@30.@_iter.fieldName` references another forEach step''s data at the same iteration index');
        O.AppendLine('15. **Use `Disabled=true` to skip steps** — disabled steps follow the success path without executing. Use this instead of deleting steps.');
        O.AppendLine('16. **LLM steps should set `roleCode`** — add `"roleCode":"HAIKU"` (or other role) in the request template to control which model is used. The code must exist in this company: verify it with `Data.Records.Get` on `Bifrost Language Model ori`');
        O.AppendLine('17. **Data.Records.Get uses `tableView` not `filter`** — the parameter name for BC filters is `tableView`, e.g. `"tableView":"WHERE(Registration Number=FILTER(<>''''))"`. Use English field names in tableView.');
        O.AppendLine('18. **Guard on the result, not just the status** — add `noOfRecords GreaterThan 0` beside `status Equals Success` on every query step whose emptiness would make the rest of the run pointless. See "`status Equals Success` is not enough".');
        O.AppendLine('19. **Write enum fields by AL name** — `NotEquals`, not the `Not Equals` caption a Get returns. Reads are localized; writes are not.');
        O.AppendLine('20. **Timeouts belong to external callers** — each step runs in-process through the dispatcher and has no request timeout of its own. An external caller of `Orchestrator.Playbook.Run` receives the answer only when the playbook finishes: use `Orchestrator.Playbook.Enqueue` for long runs. Enqueue, a schedule and Run Now in the BC client have no client timeout. A Job Queue Entry''s Job Timeout is the only outer bound for a background run.');
        O.AppendLine('21. **Verify from the step log, not the response** — a `Playbook.Run` response that never arrived says nothing about whether the run succeeded. Read `Playbook Step Log ori` filtered by instance; it is written step by step as the run progresses.');
        O.AppendLine('');
        O.AppendLine('## Execution Semantics');
        O.AppendLine('');
        O.AppendLine('- **Playbook status = Failed** only when `StepsFailed > 0`. A playbook ending via a condition branch (NextStepNo_Failure = 0 with 0 step errors) is Completed.');
        O.AppendLine('- **forEach condition false = Cancelled** (not Failed). Does not increment StepsFailed. `Skip If Step Failed` still skips these iterations in downstream steps.');
        O.AppendLine('- **Single-step condition false = branch** — follows NextStepNo_Failure path. If that path is 0, playbook ends as Completed (not Failed).');
        O.AppendLine('- **Paged steps use the step''s Request Template** — not the playbook''s initial request. The engine injects `skip`/`take` into the template.');
        O.AppendLine('- **Paged step failure** — if a paged step fails, the engine follows the paged step''s failure path (not the chain end step''s).');
        O.AppendLine('- **Workspace snapshot** — on step failure, the workspace JSON is saved to the step log for debugging. Download via the Step Log subpage.');
        O.AppendLine('- **Start condition false = Cancelled, success path** — the step logs `Skipped: start conditions not met`, `stepsSkipped` increments, and the run is not failed. This is the mechanism the reporting tail is built on.');
        O.AppendLine('- **Check steps do not fail the run for answering no** — a `Check` whose Success condition is false is Cancelled (forEach) and routes down the failure edge, but `StepsFailed` is untouched; its log says `Check answered no.` A technical failure fails the Check step and the run like an `Action`: the message type raising an error, or answering `status: "Error"` (also `Refused`, `Failed`). The step log carries the type''s `code` and `error`, and `_steps.<no>.items.errored` counts it apart from `checkFailed`.');
        O.AppendLine('- **Next Step edges apply once per step, never per item** — a forEach step runs all its iterations and then follows one edge. A per-item gate is `Skip If Step Failed = <check step no>` on the downstream forEach step. See "Per-item decisions in a forEach".');
        O.AppendLine('- **Last-run fields on the header** — every run (`Orchestrator.Playbook.Run`, `Orchestrator.Playbook.Enqueue`, a scheduled run, Run Now) writes `LastRunInstanceID`, `LastRunStatus` and `LastRunAt` on `Playbook ori`: `Running` when the run starts, then `Completed` or `Failed` when it ends. A run abandoned mid-flight therefore stays `Running` and never reads `Completed`.');
        O.AppendLine('- **Excluded steps are recorded under `_tail`** — out of the totals, still referenceable. They appear in the step log like any other step.');
        O.AppendLine('');
        O.AppendLine('## Built-in Workspace Variables');
        O.AppendLine('');
        O.AppendLine('These are seeded automatically at playbook start. No steps needed to populate them.');
        O.AppendLine('');
        O.AppendLine('### `_sys` — System Constants');
        O.AppendLine('');
        O.AppendLine('| Path | Example | Description |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `_sys.today` | `2026-08-30` | Calendar date (Today) |');
        O.AppendLine('| `_sys.workDate` | `2026-08-30` | BC posting date (WorkDate) |');
        O.AppendLine('| `_sys.now` | `2026-08-30T15:30:00Z` | Current timestamp |');
        O.AppendLine('| `_sys.year` | `2026` | Current year |');
        O.AppendLine('| `_sys.lastMonthStart` | `2026-07-01` | First day of previous month |');
        O.AppendLine('| `_sys.lastMonthEnd` | `2026-07-31` | Last day of previous month |');
        O.AppendLine('| `_sys.thisMonthStart` | `2026-08-01` | First day of current month |');
        O.AppendLine('| `_sys.thisQuarterStart` | `2026-07-01` | First day of current quarter |');
        O.AppendLine('| `_sys.thisYearStart` | `2026-01-01` | First day of current year |');
        O.AppendLine('| `_sys.companyName` | `CRONUS IS` | Current BC company |');
        O.AppendLine('| `_sys.userId` | `ADMIN` | Current user ID |');
        O.AppendLine('');
        O.AppendLine('### `_who` — User & Company Context (from Help.WhoAmI.Get)');
        O.AppendLine('');
        O.AppendLine('| Path | Example | Description |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `_who.user.userName` | `JOHN` | Login name |');
        O.AppendLine('| `_who.user.userSecurityId` | GUID | User security ID |');
        O.AppendLine('| `_who.salesperson.name` | `John Smith` | Salesperson full name |');
        O.AppendLine('| `_who.salesperson.email` | `user@company.is` | Salesperson email |');
        O.AppendLine('| `_who.salesperson.code` | `JS` | Salesperson code |');
        O.AppendLine('| `_who.salesperson.phoneNo` | `5551234` | Phone number |');
        O.AppendLine('| `_who.companyInfo.name` | `CRONUS Ltd.` | Legal company name |');
        O.AppendLine('| `_who.companyInfo.registrationNo` | `5501011490` | Company kennitala |');
        O.AppendLine('| `_who.companyInfo.vatRegistrationNo` | `00000` | VAT number |');
        O.AppendLine('| `_who.companyInfo.address` | `5 The Ring` | Company address |');
        O.AppendLine('| `_who.telegramChatId` | `123456789` | User''s Telegram chat ID |');
        O.AppendLine('| `_who.personalization.languageId` | `1033` | Session language LCID |');
        O.AppendLine('');
        BuildDataReference(O);
    end;

    local procedure BuildDataReference(var O: TextBuilder)
    begin
        O.AppendLine('## Data Reference — Tables & Fields for Data.Records.Get/Set');
        O.AppendLine('');
        O.AppendLine('### Restricted tables (dedicated message types)');
        O.AppendLine('');
        O.AppendLine('Foundation / this app block `Data.Records.Get` / `Data.Records.Set` on the tables below.');
        O.AppendLine('The error text ends with `Use {hint}.` and the response `nextStep` field carries the same dedicated types:');
        O.AppendLine('');
        O.AppendLine('| Table | Direction | Use instead |');
        O.AppendLine('|---|---|---|');
        O.AppendLine('| `Job Queue Entry` | write | `Orchestrator.Entry.Register` / `Orchestrator.Entry.Schedule` / `Orchestrator.JobQueueEntry.Restart` |');
        O.AppendLine('| `Scheduled Task` | write | `Orchestrator.Status.Restart` (no generic write) |');
        O.AppendLine('| `Report Request Preset ori` | read / write | `Orchestrator.Report.Get` / `Orchestrator.Report.Run` / `Orchestrator.Report.SaveAs` |');
        O.AppendLine('');
        O.AppendLine('IMPORTANT: Playbook steps use **message type parameter names** (e.g. `tableName`, `fieldNumbers`),');
        O.AppendLine('NOT the MCP tool shorthand names (e.g. `table`, `fields`). The playbook engine dispatches');
        O.AppendLine('through `invoke_message_type`, which passes data directly to the message type handler.');
        O.AppendLine('Always call `Help.Implementation.Get` with the message type name to see its exact parameters.');
        O.AppendLine('');
        O.AppendLine('### Orchestrator Tables');
        O.AppendLine('');
        O.AppendLine('#### Scheduled Entry ori');
        O.AppendLine('Stores configuration for each monitored Job Queue Entry.');
        O.AppendLine('');
        O.AppendLine('| Field | JSON Key | Type | Notes |');
        O.AppendLine('|---|---|---|---|');
        O.AppendLine('| ID | ID | GUID | PK — matches the Job Queue Entry ID |');
        O.AppendLine('| Object Type to Run | ObjectTypetoRun | Option | Codeunit/Report |');
        O.AppendLine('| Object ID to Run | ObjectIDtoRun | Integer | BC object ID |');
        O.AppendLine('| Description | Description | Text[250] | |');
        O.AppendLine('| Blocked | Blocked | Boolean | Prevents scheduling when true |');
        O.AppendLine('| No. of Minutes between Runs | No_ofMinutesbetweenRuns | Integer | |');
        O.AppendLine('| Run on Mondays..Sundays | RunonMondays..RunonSundays | Boolean | |');
        O.AppendLine('| Starting Time | StartingTime | Time | |');
        O.AppendLine('| Ending Time | EndingTime | Time | |');
        O.AppendLine('| Notification Type | NotificationType | Option | None/Email |');
        O.AppendLine('| Notification Recipient | NotificationRecipient | Text | Field 110: not writable through Data.Records.Set. Set with Orchestrator.Playbook.Schedule or edit on the Scheduled Entry card. |');
        O.AppendLine('| Job Queue User ID | JobQueueUserID | Code[50] | Field 140: not writable through Data.Records.Set. Edit on the Scheduled Entry card. |');
        O.AppendLine('| Retry Policy | RetryPolicy | Option | Always/Limited/None |');
        O.AppendLine('| Client Credentials Code | ClientCredentialsCode | Code[20] | For API-based scheduling |');
        O.AppendLine('');
        O.AppendLine('#### Scheduler Setup ori');
        O.AppendLine('Singleton setup table. Read with `Data.Records.Get`, tableName = "Scheduler Setup ori".');
        O.AppendLine('Job Queue User ID (field 40) cannot be written through Data.Records.Set. Edit it on the Scheduler Setup page. Reads of these three fields are unchanged; other fields remain writable generically.');
        O.AppendLine('');
        O.AppendLine('### Playbook Tables');
        O.AppendLine('');
        O.AppendLine('#### Playbook ori (PK: Code)');
        O.AppendLine('');
        O.AppendLine('| Field | JSON Key | Type | Notes |');
        O.AppendLine('|---|---|---|---|');
        O.AppendLine('| Code | Code | Code[20] | PK |');
        O.AppendLine('| Description | Description | Text[250] | |');
        O.AppendLine('| Recurring Template Code | RecurringTemplateCode | Code[20] | Links to schedule template |');
        O.AppendLine('| No. of Minutes between Runs | No_ofMinutesbetweenRuns | Integer | |');
        O.AppendLine('| Run on Mondays..Sundays | RunonMondays..RunonSundays | Boolean | |');
        O.AppendLine('| Starting/Ending Time | StartingTime/EndingTime | Time | |');
        O.AppendLine('| Notification Type | NotificationType | Option | None/Email |');
        O.AppendLine('| Scheduled | Scheduled | Boolean | FlowField — read-only |');
        O.AppendLine('| Last Run Instance ID | LastRunInstanceID | Guid | ID of the `Playbook Instance ori` of the latest run. Written by the runner when a run starts and again when it ends, for every run type; read-only |');
        O.AppendLine('| Last Run Status | LastRunStatus | Enum | Status of that instance: `Running` while in flight, then `Completed` or `Failed`. An abandoned run stays `Running`; read-only |');
        O.AppendLine('| Last Run At | LastRunAt | DateTime | When the header was last stamped: the start of the run, then its end; read-only |');
        O.AppendLine('');
        O.AppendLine('#### Playbook Step ori (PK: PlaybookCode + StepNo_)');
        O.AppendLine('');
        O.AppendLine('| Field | JSON Key | Type | Notes |');
        O.AppendLine('|---|---|---|---|');
        O.AppendLine('| Playbook Code | PlaybookCode | Code[20] | PK |');
        O.AppendLine('| Step No. | StepNo_ | Integer | PK — use 10, 20, 30... |');
        O.AppendLine('| Description | Description | Text[250] | |');
        O.AppendLine('| Message Type | MessageType | Option | The Bifrost message type to call |');
        O.AppendLine('| Next Step No. (Success) | NextStepNo_Success | Integer | 0 = end playbook |');
        O.AppendLine('| Next Step No. (Failure) | NextStepNo_Failure | Integer | 0 = fail playbook |');
        O.AppendLine('| Request Template | RequestTemplate | BLOB | JSON template with `@path` workspace refs (set as base64) |');
        O.AppendLine('| Result Log Paths | ResultLogPaths | Text[2048] | Paths to extract from response to workspace. `source>target` renames, `source[0]>target` extracts first element |');
        O.AppendLine('| Iterate Array Path | IterateArrayPath | Text[250] | Dot-path to array for foreach |');
        O.AppendLine('| Iterate Source Step No. | IterateSourceStepNo_ | Integer | Which step''s response has the array |');
        O.AppendLine('| Step Type | StepType | Option | Action (default) or Check — is a false Success condition a failure? |');
        O.AppendLine('| Summary Paths | SummaryPaths | Text[2048] | Response paths copied into the run report. Keep small |');
        O.AppendLine('| Exclude From Run Status | ExcludeFromRunStatus | Boolean | Keep this step out of _run and _steps |');
        O.AppendLine('| Stop On Item Error | StopOnItemError | Boolean | For foreach: abort on first failure |');
        O.AppendLine('| Skip If Step Failed | SkipIfStepFailed | Integer | The per-item gate: skip this iteration if the named step''s same iteration did not succeed, an answer of no included. Next Step edges are per step, not per item |');
        O.AppendLine('| Paged | Paged | Boolean | Enable auto-paging (skip/take) |');
        O.AppendLine('| Page Size | PageSize | Integer | Records per page (default 500) |');
        O.AppendLine('| Page Through Step No. | PageThroughStepNo_ | Integer | Last step in paged chain |');
        O.AppendLine('| Disabled | Disabled | Boolean | Skip this step without executing |');
        O.AppendLine('');
        O.AppendLine('#### Playbook Condition ori (PK: PlaybookCode + StepNo_ + ConditionType + GroupNo_ + LineNo_)');
        O.AppendLine('');
        O.AppendLine('| Field | JSON Key | Type | Notes |');
        O.AppendLine('|---|---|---|---|');
        O.AppendLine('| Playbook Code | PlaybookCode | Code[20] | PK |');
        O.AppendLine('| Step No. | StepNo_ | Integer | PK — the step this condition guards |');
        O.AppendLine('| Condition Type | ConditionType | Enum | PK — Start, Success or Error |');
        O.AppendLine('| Group No. | GroupNo_ | Integer | PK — conditions in one group are ANDed; groups are ORed |');
        O.AppendLine('| Line No. | LineNo_ | Integer | PK — use 10000, 20000, ... |');
        O.AppendLine('| Path | Path | Text[250] | Dot-path. Start/Error read the workspace, Success reads the step response |');
        O.AppendLine('| Operator | Operator | Enum | Equals, NotEquals, Contains, GreaterThan, LessThan, GreaterOrEqual, LessOrEqual, Exists |');
        O.AppendLine('| Value | Value | Text[250] | Compared as text; numeric operators parse both sides |');
        O.AppendLine('| Description | Description | Text[100] | Why this condition exists. Optional, and worth writing |');
        O.AppendLine('');
        O.AppendLine('Deleting a step cascades to its conditions. An empty condition set is true, so a step');
        O.AppendLine('with no Success conditions succeeds whenever the message type does not raise an error.');
        O.AppendLine('');
        O.AppendLine('### Execution Log Tables (read-only)');
        O.AppendLine('');
        O.AppendLine('#### Playbook Instance ori (PK: ID)');
        O.AppendLine('One record per playbook run. Fields: PlaybookCode, Status, StartedAt, CompletedAt,');
        O.AppendLine('TotalDuration, StepsExecuted, StepsFailed, ItemsProcessed, InitiatedBy, ErrorText, Context.');
        O.AppendLine('');
        O.AppendLine('`Status` stays `Running` until the run writes its own completion, so an instance');
        O.AppendLine('abandoned mid-flight — a session killed, a caller that timed out — stays `Running`');
        O.AppendLine('for ever. Judge such a run by the timestamps on its step log, not by this field.');
        O.AppendLine('');
        O.AppendLine('#### Playbook Step Log ori (PK: InstanceID + StepNo_ + IterationNo_)');
        O.AppendLine('One record per step execution. Fields: MessageType, Status, Duration, ErrorText,');
        O.AppendLine('RequestSent (base64 BLOB), ResponseReceived (base64 BLOB), IteratorElement, WorkspaceSnapshot (base64 BLOB, only on failed steps).');
        O.AppendLine('');
    end;
}
